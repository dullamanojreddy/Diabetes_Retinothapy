# backend/.env.example
APP_ENV=development
HOST=0.0.0.0
PORT=8000

MODEL_PATH=./models/best_efficientnet_b3.pth
MODEL_DEVICE=auto
MODEL_VERSION=b3-aptos-epoch7

MAX_UPLOAD_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png

REFERABLE_THRESHOLD=0.13

STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
RESULT_DIR=./storage/results
HISTORY_FILE=./storage/history.json

FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
